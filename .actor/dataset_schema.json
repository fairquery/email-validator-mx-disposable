{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "schema_version": {
                "type": "string",
                "title": "Schema version",
                "example": "1.0.0"
            },
            "type": {
                "type": "string",
                "title": "Row type",
                "enum": [
                    "email",
                    "error"
                ]
            },
            "source_url": {
                "type": "string",
                "title": "Source URL",
                "description": "DNS-over-HTTPS query URL (or RFC for syntax-only rows)."
            },
            "checked_at": {
                "type": "string",
                "title": "Checked at"
            },
            "input": {
                "type": "string",
                "title": "Input"
            },
            "email": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Normalized email"
            },
            "local_part": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Local part"
            },
            "domain": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Domain"
            },
            "verdict": {
                "type": "string",
                "title": "Verdict",
                "enum": [
                    "valid",
                    "risky",
                    "invalid",
                    "unknown"
                ]
            },
            "reasons": {
                "type": "array",
                "title": "Reason codes"
            },
            "syntax_valid": {
                "type": "boolean",
                "title": "Syntax valid"
            },
            "is_disposable": {
                "type": "boolean",
                "title": "Disposable"
            },
            "is_role_account": {
                "type": "boolean",
                "title": "Role account"
            },
            "is_free_provider": {
                "type": "boolean",
                "title": "Free provider"
            },
            "did_you_mean": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Did you mean"
            },
            "domain_exists": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Domain exists"
            },
            "has_mx": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Has MX"
            },
            "null_mx": {
                "type": "boolean",
                "title": "Null MX"
            },
            "implicit_mx": {
                "type": "boolean",
                "title": "Implicit MX (A record only)"
            },
            "mx_records": {
                "type": "array",
                "title": "MX records"
            },
            "mail_provider": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Mail provider"
            },
            "has_spf": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Has SPF"
            },
            "has_dmarc": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Has DMARC"
            },
            "dmarc_policy": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "DMARC policy"
            },
            "code": {
                "type": "string",
                "title": "Error code"
            },
            "message": {
                "type": "string",
                "title": "Error message"
            },
            "retryable": {
                "type": "boolean",
                "title": "Retryable"
            },
            "context": {
                "type": "object",
                "title": "Error context"
            }
        },
        "required": [
            "schema_version",
            "type",
            "source_url",
            "checked_at"
        ]
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "input",
                    "verdict",
                    "reasons",
                    "did_you_mean",
                    "mail_provider",
                    "is_disposable",
                    "is_role_account",
                    "is_free_provider",
                    "code"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": {
                        "label": "Row type"
                    },
                    "input": {
                        "label": "Input"
                    },
                    "verdict": {
                        "label": "Verdict"
                    },
                    "reasons": {
                        "label": "Reason codes"
                    },
                    "did_you_mean": {
                        "label": "Did you mean"
                    },
                    "mail_provider": {
                        "label": "Mail provider"
                    },
                    "is_disposable": {
                        "label": "Disposable"
                    },
                    "is_role_account": {
                        "label": "Role account"
                    },
                    "is_free_provider": {
                        "label": "Free provider"
                    },
                    "code": {
                        "label": "Error code"
                    }
                }
            }
        }
    }
}